{
  "manifest_version": 3,
  "name": "Flow Studiox",
  "version": "1.0.0",
  "description": "Edit the opened Salesforce flow with Claude and save a draft through Metadata API.",
  "permissions": ["activeTab", "storage", "identity"],
  "host_permissions": ["https://*.salesforce.com/*", "https://*.salesforce-setup.com/*", "https://*.force.com/*", "https://api.anthropic.com/*"],
  "action": { "default_title": "Open Flow Studiox" },
  "background": { "service_worker": "background.js" }
}
